#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mfcl=$root/mfclo64
reference=$root/results/reference/final.par

test -x "$mfcl"
test -s "$reference"
test "$(find "$root/model/model-inputs" -maxdepth 1 -type f | wc -l)" -eq 1
test "$(find "$root/model/selectivity-models" -maxdepth 1 -type f | wc -l)" -eq 1
test -s "$root/model/model-inputs/Diagnostic.conf"
test -s "$root/model/selectivity-models/Diagnostic.csv"
test "$(sha256sum "$root/model/selectivity-models/Diagnostic.csv" | awk '{ print $1 }')" = \
  790e21a01054349a20f4fbbb7db926f6452d059344815a3a9d6a5de51db3310a

. "$root/model/model-inputs/Diagnostic.conf"
test "$MODEL_ID" = Diagnostic
test "$SELECTIVITY_MODEL" = Diagnostic
test "$SELECTIVITY_INPUT" = selectivity-models/Diagnostic.csv

ini_steepness=$(awk '
  /^# sv[(]29[)]/ { getline; print $1; found++; exit }
  END { if (found != 1) exit 1 }
' "$root/model/bet.ini")
test "$ini_steepness" = "$STEEPNESS"

if grep -Ev '^[[:space:]]*#' "$root/model/doitall.sh" | grep -Eiq 'seed.?23|checkpoint'; then
  echo "Diagnostic doitall contains a seed or checkpoint path." >&2
  exit 1
fi

(
  cd "$root/model"
  MODEL_ID=Diagnostic MODEL_AUDIT_PAR="$reference" \
    PROGRAM_PATH="$mfcl" ./doitall.sh
)

controls=$(
  cd "$root/model"
  MODEL_ID=Diagnostic SELECTIVITY_PRINT_CONTROLS=1 \
    PROGRAM_PATH="$mfcl" ./doitall.sh |
    awk '/^[[:space:]]+-[0-9]+[[:space:]]/ { print }'
)
test "$(printf '%s\n' "$controls" | awk 'NF { rows++ } END { print rows + 0 }')" -eq 198
test "$(printf '%s\n' "$controls" | sha256sum | awk '{ print $1 }')" = \
  6ebd3aa22d6b88a2504214e2913a65c6b3257249f985482ca4a8981fb72a9c58
printf '%s\n' "$controls" | awk '
  NF && $2 != 16 && $2 != 24 && $2 != 56 && $2 != 57 && $2 != 61 {
    print "Unexpected Diagnostic selectivity flag: " $0 > "/dev/stderr"
    exit 1
  }
'

printf '%s\n' "$controls" | awk '
  $1 == -10 && $2 == 16 && $3 == 1 { f10_16++ }
  $1 == -10 && $2 == 56 && $3 == 10000 { f10_56++ }
  $1 == -33 && $2 == 16 && $3 == 1 { f33_16++ }
  $1 == -33 && $2 == 56 && $3 == 10000 { f33_56++ }
  $2 == 24 && -$1 != $3 { bad_group++ }
  END {
    exit(f10_16 == 1 && f10_56 == 1 && f33_16 == 1 && f33_56 == 1 &&
         bad_group == 0 ? 0 : 1)
  }
'

printf '%s\n' "$controls" | awk '
  FILENAME == ARGV[1] {
    if (FNR == 1) next
    split($0, values, ",")
    fishery=values[1]
    expected[fishery,16]=values[3]
    expected[fishery,24]=values[4]
    expected[fishery,56]=values[5]
    expected[fishery,57]=values[6]
    expected[fishery,61]=values[7]
    expected_rows++
    next
  }
  FILENAME == "-" && NF {
    fishery=-$1
    flag=$2
    if (!(fishery SUBSEP flag in expected) || $3 != expected[fishery,flag]) {
      print "Generated control does not match explicit selectivity input: " $0 > "/dev/stderr"
      failures++
    }
    observed[fishery,flag]++
  }
  END {
    for (fishery=1; fishery<=33; fishery++) {
      for (flag_index=1; flag_index<=5; flag_index++) {
        flag=(flag_index == 1 ? 16 : flag_index == 2 ? 24 : flag_index == 3 ? 56 : flag_index == 4 ? 57 : 61)
        wanted=(flag == 24 ? 2 : 1)
        if (observed[fishery,flag] != wanted) failures++
      }
    }
    exit(expected_rows == 33 && failures == 0 ? 0 : 1)
  }
' "$root/model/selectivity-models/Diagnostic.csv" -

# Prove that the native recipe is genuinely standalone. Only the MFCL
# executable, its native BET inputs, mfcl.cfg and doitall.sh are copied; no
# model-input config or selectivity CSV is available in this directory.
temp_root=${TMPDIR:-/tmp}
temp_root=$(CDPATH= cd -- "$temp_root" && pwd -P)
minimal_dir=$(mktemp -d "$temp_root/bet-diagnostic-minimal.XXXXXX")
minimal_dir=$(CDPATH= cd -- "$minimal_dir" && pwd -P)
case "$minimal_dir" in
  "$temp_root"/bet-diagnostic-minimal.*) ;;
  *) echo "Unsafe temporary directory: $minimal_dir" >&2; exit 1 ;;
esac
cleanup()
{
  case "$minimal_dir" in
    "$temp_root"/bet-diagnostic-minimal.*)
      if [ -d "$minimal_dir" ] && [ ! -L "$minimal_dir" ]; then
        rm -rf -- "$minimal_dir"
      fi
      ;;
  esac
}
trap cleanup EXIT HUP INT TERM
cp "$root/model/bet.age_length" "$root/model/bet.frq" \
  "$root/model/bet.ini" "$root/model/bet.reg_scaling" \
  "$root/model/bet.tag" "$root/model/mfcl.cfg" \
  "$root/model/doitall.sh" "$root/mfclo64" "$minimal_dir/"
test ! -e "$minimal_dir/model-inputs"
test ! -e "$minimal_dir/selectivity-models"
minimal_controls=$(
  cd "$minimal_dir"
  SELECTIVITY_PRINT_CONTROLS=1 ./doitall.sh |
    awk '/^[[:space:]]+-[0-9]+[[:space:]]/ { print }'
)
test "$minimal_controls" = "$controls"
(
  cd "$minimal_dir"
  MODEL_STOP_AFTER_PHASE0=1 ./doitall.sh
)

echo "Diagnostic Job 21641 h=0.90, tau=2, M, DM and selectivity audits passed."
